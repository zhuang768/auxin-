{
  "manifest_version": 3,
  "name": "竹青安心GO",
  "version": "1.0.0",
  "description": "在資料離開裝置前，於本機辨識可能的個資並提供安全遮蔽。原始 Prompt 不上傳。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "竹青安心GO"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ]
}
