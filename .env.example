# 竹青安心GO Demo 環境變數範例
# 複製為 .env 後填入本機值。不要把真實 token、密碼或憑證提交到 repository。
# 所有預設值都只適用於競賽 Demo，不可用於正式環境。

# FastAPI / Uvicorn
HOST=127.0.0.1
PORT=8000

# SQLite 路徑（相對於 backend/ 或使用絕對路徑）
DATABASE_PATH=data/app.db

# 工作階段與 CSRF 簽名。請在本機改成隨機長字串。
SESSION_SECRET=replace-with-a-long-random-demo-secret

# 完成憑證 HMAC 金鑰。請在本機改成另一組隨機長字串。
ATTESTATION_HMAC_SECRET=replace-with-a-long-random-hmac-secret

# Demo 管理員帳密。畫面會標示不可用於正式環境。
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_PASSWORD=demo-admin-not-for-production

# 完成憑證 nonce 有效秒數
NONCE_TTL_SECONDS=300

# LINE Messaging API（Phase 1：Webhook、Welcome Message、Rich Menu）
# 從 LINE Developers Console 的 Messaging API channel 取得。不可提交真實值。
# Webhook URL：https://<your-host>/api/line/webhook
# 未填 LINE_CHANNEL_SECRET 時，Webhook 會回 401。
# 未填 LINE_CHANNEL_ACCESS_TOKEN 時，不會呼叫 LINE reply / Rich Menu API。
# 這不是新竹市政府正式官方帳號；沒有授權時不可對外宣稱已整合市政府 LINE。
LINE_MESSAGING_ENABLED=false
LINE_DRY_RUN=true
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TO_USER_ID=

# LINE API 主機固定為 https://api.line.me 與 https://api-data.line.me，不可用環境變數改寫。
# Email / SMS 轉接器目前僅 PoC，預設不發送
EMAIL_ENABLED=false
SMS_ENABLED=false
